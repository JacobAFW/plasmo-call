# =============================================================================
# plasmo-call — Snakefile
# Full pipeline: fastq → mapped/dupmarked BAM → optional BQSR → GATK4 arm
# (HC per-sample → GenomicsDBImport (or CombineGVCFs) → GenotypeGVCFs per
# INTERVAL → per-chrom concat) ‖ bcftools arm (mpileup|call per interval →
# per-chrom concat) → position-based CONSENSUS per chrom → Consensus.vcf.gz
# → filter tiers (raw + LIGHT + HARD) + funnel stats (Prompt H,
# decoupled from calling).
#
# REMOVED vs GATK3 predecessor: RealignerTargetCreator + IndelRealigner
# (GATK4 HaplotypeCaller local reassembly subsumes them).
# =============================================================================

configfile: "config/config.yaml"

include: "rules/common.smk"           # config load + sample/interval wrangling
include: "rules/mapping.smk"          # bwa / bwa-mem2, sort, markdup, reheader
include: "rules/bqsr.smk"             # BaseRecalibrator/ApplyBQSR (+ bootstrap)
include: "rules/calling_gatk.smk"     # HC -> {GenomicsDBImport | CombineGVCFs} -> GenotypeGVCFs per interval
include: "rules/calling_bcftools.smk" # mpileup|call per interval -> per-chrom concat
include: "rules/consensus.smk"        # GATK ∩ bcftools positions -> concat
include: "rules/filter.smk"           # raw Consensus -> LIGHT + HARD tiers + funnel stats

# Final targets — three VCFs + funnel report, all ALWAYS emitted (Prompt H):
#   * Consensus.vcf.gz             — RAW consensus (reproducible base).
#   * Consensus.light.vcf.gz       — LIGHT tier (QUAL floor; vivaxgen-equivalent).
#   * Consensus.hard.vcf.gz        — HARD tier (Sanger-style GATK hard filter).
#   * output/filter/stats.{txt,tsv} — RAW → LIGHT → HARD funnel + per-site
#                                     distributions with tier cuts annotated.
# The filter/stats rules consume ONLY the raw Consensus.vcf.gz — amending a
# threshold and re-running regenerates them WITHOUT re-calling.
rule all:
    input:
        "output/calling/consensus/Consensus.vcf.gz",
        "output/calling/consensus/Consensus.light.vcf.gz",
        "output/calling/consensus/Consensus.hard.vcf.gz",
        "output/filter/stats.txt",
        "output/filter/stats.tsv",
